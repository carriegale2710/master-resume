# Private resume header values. Copy this file to .env (gitignored) and fill in your real details there.
# scripts/build.sh fills the ${RESUME_*} and ${*_URL} placeholders in drafts from .env at docx build time.
# The *_URL values are optional. Never put real values in this file.

RESUME_NAME="Your Name"
RESUME_EMAIL="you@example.com"
RESUME_LOCATION="City, Country"
RESUME_PHONE="614xxxxxxxx"
RESUME_WORKRIGHTS="Citizen"
GITHUB_URL="github.com/yourgithubusername"
LINKEDIN_URL="linkedin.com/in/yourlinkedinusername"
PORTFOLIO_URL="yourportfolio.com"